# ==============================================================================
# SENTINEL Backend Environment Configuration (Render / Server)
# Copy to server/.env for local overrides (NEVER commit actual secrets)
# ==============================================================================

PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Storage Mode: 'supabase' (genuine PostgreSQL persistence), 'file' (local JSON), or 'memory' (ephemeral)
STORAGE_MODE=supabase
DATA_DIR=./data

# Supabase Server-Side Persistence & Authentication (SERVICE ROLE - NEVER EXPOSE TO FRONTEND)
# In Render Dashboard: Set as Environment Secret
SUPABASE_URL=https://cajrbzfsfsimxweomrlt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Realtime Server-Sent Events (SSE)
ENABLE_SSE=true
SSE_HEARTBEAT_INTERVAL_MS=15000

# Telemetry simulation ticks
TELEMETRY_TICK_INTERVAL_MS=3000
ENABLE_AUTO_TELEMETRY=true

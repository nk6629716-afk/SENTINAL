# SENTINEL Backend Environment Configuration Example
# Copy to .env for local overrides

PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Storage configuration: 'file' (JSON persistence with atomic file writes) or 'memory'
STORAGE_MODE=file
DATA_DIR=./data

# Realtime configuration
ENABLE_SSE=true
SSE_HEARTBEAT_INTERVAL_MS=15000

# Telemetry simulation ticks
TELEMETRY_TICK_INTERVAL_MS=3000
ENABLE_AUTO_TELEMETRY=true

# Supabase Database Configuration
# Configure securely in Render environment variables; never commit real secrets
SUPABASE_URL=https://cajrbzfsfsimxweomrlt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


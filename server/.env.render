# SENTINEL Backend - Render Production Environment Variables
# Copy these values into your Render Web Service -> Environment -> Environment Variables

# Node Environment
NODE_ENV=production

# Server Port (Render sets PORT automatically, but default is 10000)
PORT=10000

# CORS Allowed Origin
# Set to '*' for open development/testing, or set to your Netlify URL:
# e.g. CORS_ORIGIN=https://sentinel-fallingsun.netlify.app
CORS_ORIGIN=*

# Storage Mode: 'file' or 'memory'
# 'file' persists data locally; 'memory' stores state in-memory during container lifetime
STORAGE_MODE=file

# Real-time Server-Sent Events (SSE)
ENABLE_SSE=true

# Keep-alive heartbeat interval in milliseconds (prevents Render proxy timeout on free tier)
SSE_HEARTBEAT_INTERVAL_MS=15000

# Live Telemetry Stream
TELEMETRY_TICK_INTERVAL_MS=3000
ENABLE_AUTO_TELEMETRY=true

# ==============================================================================
# SENTINEL Root Environment Configuration Template
# Copy to .env for local development overrides (NEVER commit .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT ENVIRONMENT (Vite Public Variables)
# Safe for browser bundles. NEVER place service role keys in VITE_* variables!
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_SUPABASE_URL=https://cajrbzfsfsimxweomrlt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER ENVIRONMENT (Render Web Service)
# Sensitive server credentials. Set in Render Dashboard -> Environment Variables.
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*
STORAGE_MODE=supabase
SUPABASE_URL=https://cajrbzfsfsimxweomrlt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Realtime & Telemetry Engine
ENABLE_SSE=true
SSE_HEARTBEAT_INTERVAL_MS=15000
TELEMETRY_TICK_INTERVAL_MS=3000
ENABLE_AUTO_TELEMETRY=true
